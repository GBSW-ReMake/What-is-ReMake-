---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog"))
  .filter((post) => import.meta.env.PROD ? !post.data.draft : true)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout title="Tech Blog — GBSW ReMake" description="What we learned. 실제 개발·운영하면서 겪은 문제와 해결 과정.">
  <section class="section">
    <div class="wrap">
      <h1 class="head">What we learned</h1>
      <p class="dek">단순 튜토리얼이 아니라, 실제로 만들고 운영하면서 겪은 문제와 해결 과정을 기록합니다.</p>

      {posts.length === 0 ? (
        <p class="empty">아직 올라온 글이 없습니다. 첫 글을 기다리고 있어요.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post">
              <a class="post__link" href={`/blog/${post.id}`}>
                <p class="post__meta">
                  {post.data.publishDate.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" })}
                  {" · "}{post.data.author}
                  {post.data.draft && <span class="post__draft">DRAFT</span>}
                </p>
                <h2 class="post__title">{post.data.title}</h2>
                <p class="post__description">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-block: var(--space-3xl); }
  .head {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg);
  }
  .dek {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    max-width: 48ch;
    margin: 0 0 var(--space-xl);
  }
  .empty { color: var(--color-ink-2); }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 60rem;
  }
  .post {
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .post:last-child { border-bottom: var(--rule-hair) solid var(--color-rule); }
  .post__link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding-block: var(--space-lg);
    transition: opacity var(--dur-short) var(--ease-out);
  }
  .post__link:hover,
  .post__link:focus-visible { opacity: 0.6; }
  .post__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-xs);
  }
  .post__draft {
    color: var(--color-accent-ink);
    margin-left: var(--space-sm);
  }
  .post__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2xs);
  }
  .post__description {
    color: var(--color-ink-2);
    max-width: 60ch;
    margin: 0;
  }
</style>
