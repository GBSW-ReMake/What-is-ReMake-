---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  author: string;
  tags: string[];
}

const { title, description, publishDate, author, tags } = Astro.props;
const dateLabel = publishDate.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`${title} — GBSW ReMake Blog`} description={description}>
  <article class="section">
    <div class="wrap wrap--narrow">
      <a class="link back-link" href="/blog">← Blog</a>
      <p class="meta">{dateLabel} · {author}</p>
      <h1 class="head">{title}</h1>
      {tags.length > 0 && (
        <p class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</p>
      )}
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .section { padding-block: var(--space-3xl); }
  .back-link { margin-bottom: var(--space-xl); }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    margin: var(--space-lg) 0 var(--space-sm);
  }
  .head {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-md);
  }
  .tags {
    display: flex;
    gap: var(--space-sm);
    margin: 0 0 var(--space-2xl);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
    border: var(--rule-hair) solid var(--color-rule);
    padding: var(--space-3xs) var(--space-sm);
  }
  .prose {
    max-width: 65ch;
    padding-top: var(--space-xl);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-2xl);
    margin: var(--space-2xl) 0 var(--space-md);
  }
  .prose :global(p) {
    font-size: var(--text-md);
    line-height: 1.6;
    margin: 0 0 var(--space-md);
  }
  .prose :global(pre) {
    padding: var(--space-md);
    background: var(--color-bleed);
    color: var(--color-on-bleed);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .prose :global(code) { font-family: var(--font-mono); }
  .prose :global(img) { margin-block: var(--space-md); }
</style>
