---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.status === "active")
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="screen screen--02" id="screen-what-we-make" aria-label="Project">
  <div class="wrap screen__head">
    <p class="screen__eyebrow reveal" style="--i:0">Project</p>
    <h2 class="screen__display reveal" style="--i:1">What we've made</h2>
  </div>

  <div class="project-rail reveal" style="--i:2">
    {projects.length > 1 && (
      <button class="project-rail__nav project-rail__nav--prev" type="button" data-rail-prev aria-label="이전 프로젝트">←</button>
    )}
    <ul class="project-rail__track" class:list={{ "is-single": projects.length <= 1 }} data-rail-track role="region" aria-label="프로젝트 목록" tabindex="0">
      {projects.map((project) => (
        <li class="project-card" data-rail-card>
          <a class="project-card__inner" href={`/projects/${project.id}`}>
            <span class="project-card__tag">{project.data.stack.join(" · ")}</span>
            <h3 class="project-card__title">{project.data.title}</h3>
            <p class="project-card__desc">{project.data.tagline}</p>
            <span class="project-card__cta">View Project →</span>
          </a>
        </li>
      ))}
    </ul>
    {projects.length > 1 && (
      <button class="project-rail__nav project-rail__nav--next" type="button" data-rail-next aria-label="다음 프로젝트">→</button>
    )}
  </div>
</section>

<style>
  .screen--02 {
    min-height: calc(100dvh - 4.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2xl);
    background: var(--color-paper);
    border-top: var(--rule-hair) solid var(--color-rule);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
    overflow: clip;
  }
  .screen__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-md);
  }
  .screen__display {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display-screen);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg);
  }
  .screen__claim {
    font-size: var(--text-md);
    max-width: 44ch;
    margin: 0;
    color: var(--color-ink-2);
  }

  .project-rail {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-inline: var(--page-gutter);
  }
  .project-rail__track {
    list-style: none;
    margin: 0;
    padding: var(--space-lg) 0;
    display: flex;
    gap: var(--space-xl);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 10%;
    perspective: 1400px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .project-rail__track.is-single { justify-content: center; }
  .project-rail__track::-webkit-scrollbar { display: none; }
  .project-rail__track:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 6px; }

  .project-card {
    --rot-y: 0deg;
    --scale: 1;
    --tz: 0px;
    --hover-rx: 0deg;
    --hover-ry: 0deg;
    --hover-tz: 0px;
    flex: 0 0 auto;
    width: min(20rem, 78vw);
    scroll-snap-align: center;
    transform-style: preserve-3d;
    transform:
      rotateY(var(--rot-y))
      scale(var(--scale))
      translateZ(var(--tz))
      rotateX(var(--hover-rx))
      rotateY(var(--hover-ry))
      translateZ(var(--hover-tz));
    transition: transform 300ms var(--ease-out), opacity 300ms var(--ease-out);
    will-change: transform;
  }
  .project-card.is-hovering {
    transition: opacity 300ms var(--ease-out);
  }
  .project-card__inner {
    height: 100%;
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    background: var(--color-ink);
    color: var(--color-paper);
    padding: var(--space-xl);
    aspect-ratio: 3 / 4;
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .project-card__inner:hover,
  .project-card__inner:focus-visible {
    background: color-mix(in oklch, var(--color-ink) 85%, var(--color-accent-ink) 15%);
  }
  .project-card__tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-bleed-2);
  }
  .project-card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-2xl);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .project-card__desc {
    font-size: var(--text-sm);
    color: var(--color-on-bleed-2);
    margin: var(--space-2xs) 0 0;
  }
  .project-card__cta {
    margin-top: var(--space-md);
    display: inline-block;
    width: fit-content;
    font-size: var(--text-sm);
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-on-bleed-2);
    transition: color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out);
  }
  .project-card__inner:hover .project-card__cta,
  .project-card__inner:focus-visible .project-card__cta {
    color: var(--color-accent-2);
    border-color: var(--color-accent-2);
  }

  .project-rail__nav {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    background: none;
    border: var(--rule-hair) solid var(--color-rule);
    color: var(--color-ink);
    font-size: var(--text-md);
    cursor: pointer;
    transition: border-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }
  .project-rail__nav:hover,
  .project-rail__nav:focus-visible {
    border-color: var(--color-accent-ink);
    color: var(--color-accent-ink);
  }

  @media (max-width: 60rem) {
    .screen--02 { min-height: auto; }
    .project-rail__nav { display: none; }
    .project-rail { padding-inline: 0; }
    .project-rail__track { scroll-padding-inline: var(--page-gutter); padding-inline: var(--page-gutter); }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-rail-track]");
  const cards = document.querySelectorAll<HTMLElement>("[data-rail-card]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-rail-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-rail-next]");

  if (track && cards.length) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const MAX_ROTATE = 26; // degrees

    const applyTilt = () => {
      const trackRect = track.getBoundingClientRect();
      const trackCenter = trackRect.left + trackRect.width / 2;

      cards.forEach((card) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const offset = (cardCenter - trackCenter) / (trackRect.width / 2);
        const clamped = Math.max(-1, Math.min(1, offset));

        if (reduceMotion) {
          card.style.transform = "none";
          card.style.opacity = "1";
          return;
        }

        const rotateY = clamped * -MAX_ROTATE;
        const scale = 1 - Math.abs(clamped) * 0.12;
        const translateZ = -Math.abs(clamped) * 60;
        card.style.setProperty("--rot-y", `${rotateY}deg`);
        card.style.setProperty("--scale", String(scale));
        card.style.setProperty("--tz", `${translateZ}px`);
        card.style.opacity = String(1 - Math.abs(clamped) * 0.35);
      });
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        applyTilt();
        ticking = false;
      });
    };

    track.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    applyTilt();

    if (!reduceMotion) {
      const HOVER_MAX_ROTATE = 10; // degrees
      const HOVER_TZ = 24; // px lift toward the viewer

      cards.forEach((card) => {
        card.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "touch") return;
          card.classList.add("is-hovering");
        });

        card.addEventListener("pointermove", (event) => {
          if (event.pointerType === "touch") return;
          const rect = card.getBoundingClientRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const rotateX = (0.5 - py) * HOVER_MAX_ROTATE * 2;
          const rotateY = (px - 0.5) * HOVER_MAX_ROTATE * 2;
          card.style.setProperty("--hover-rx", `${rotateX.toFixed(2)}deg`);
          card.style.setProperty("--hover-ry", `${rotateY.toFixed(2)}deg`);
          card.style.setProperty("--hover-tz", `${HOVER_TZ}px`);
        });

        card.addEventListener("pointerleave", () => {
          card.classList.remove("is-hovering");
          card.style.setProperty("--hover-rx", "0deg");
          card.style.setProperty("--hover-ry", "0deg");
          card.style.setProperty("--hover-tz", "0px");
        });
      });
    }

    const scrollByCard = (direction: 1 | -1) => {
      const card = cards[0];
      const step = card.getBoundingClientRect().width + 32; // + gap
      track.scrollBy({ left: step * direction, behavior: reduceMotion ? "auto" : "smooth" });
    };

    prevBtn?.addEventListener("click", () => scrollByCard(-1));
    nextBtn?.addEventListener("click", () => scrollByCard(1));
  }
</script>
