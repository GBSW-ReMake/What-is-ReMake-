---
const members = [
  { handle: "4n5rud", role: "Backend" },
  { handle: "kec08", role: "App" },
  // 새 팀원은 이 배열에 { handle: "...", role: "..." } 를 추가하세요.
];
---

<section class="screen screen--04" id="members" aria-label="Who Makes ReMake?">
  <div class="wrap">
    <h2 class="who-intro reveal" style="--i:0">WHO<br />MAKES<br /><span class="brand-mark">ReMake</span>?</h2>

    <ul class="member-grid reveal" style="--i:1">
      {members.map((member) => (
        <li class="member">
          <a class="member__link" href={`https://github.com/${member.handle}`} target="_blank" rel="noopener">
            <img class="member__avatar" src={`https://github.com/${member.handle}.png?size=200`} alt="" width="96" height="96" loading="lazy" />
            <span class="member__name">{member.handle}</span>
            <span class="member__role">{member.role}</span>
            <span class="member__github">GitHub →</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="who-cta reveal" style="--i:2">
      <p class="who-cta__line">Different skills.<br />Same curiosity.</p>
      <p class="who-cta__line who-cta__line--accent">Build something.<br />Make it real.</p>
      <div class="who-cta__buttons">
        <a class="btn btn--outline" href="https://github.com/GBSW-ReMake" target="_blank" rel="noopener">GitHub</a>
        <a class="btn btn--outline" href="/projects">Projects</a>
        <a class="btn btn--outline" href="/blog">Tech Blog</a>
      </div>
    </div>
  </div>

  <div class="who-signature" data-signature>
    <canvas class="who-signature__canvas" aria-hidden="true"></canvas>
  </div>
</section>

<style>
  .screen--04 {
    background: var(--color-paper);
    padding-block: var(--space-3xl);
  }
  .who-intro {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display-screen);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2xl);
  }

  .member-grid {
    list-style: none;
    margin: 0 0 var(--space-3xl);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(0, min(12rem, 100%)));
    gap: var(--space-2xl) var(--space-lg);
  }
  .member__link {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    text-decoration: none;
    color: inherit;
  }
  .member__avatar {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-paper-2);
    outline: var(--rule-hair) solid transparent;
    outline-offset: 3px;
    transition: outline-color var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
  }
  .member__link:hover .member__avatar,
  .member__link:focus-visible .member__avatar {
    outline-color: var(--color-accent-ink);
    transform: scale(1.06);
  }
  .member__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-md);
  }
  .member__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .member__github {
    font-size: var(--text-sm);
    color: var(--color-accent-ink);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
  }
  .member__link:hover .member__github,
  .member__link:focus-visible .member__github {
    opacity: 1;
    transform: translateY(0);
  }

  .who-cta {
    border-top: var(--rule-hair) solid var(--color-rule);
    padding-top: var(--space-2xl);
  }
  .who-cta__line {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-2xl);
    line-height: 1.2;
    margin: 0 0 var(--space-lg);
  }
  .who-cta__line--accent { color: var(--color-accent-ink); }
  .who-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .who-signature {
    position: relative;
    height: 40vh;
    min-height: 16rem;
    margin-top: var(--space-3xl);
  }
  .who-signature__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-ink);
  }

  @media (max-width: 60rem) {
    .who-signature { height: 30vh; min-height: 12rem; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ParticleField, prefersReducedMotion } from "../../lib/particle-text";

  gsap.registerPlugin(ScrollTrigger);

  const signature = document.querySelector<HTMLElement>("[data-signature]");
  const canvas = signature?.querySelector<HTMLCanvasElement>(".who-signature__canvas");

  if (signature && canvas) {
    const isDesktop = window.matchMedia("(min-width: 60rem)").matches;
    const field = new ParticleField(canvas, "ReMake", {
      color: getComputedStyle(canvas).color,
    });

    if (prefersReducedMotion() || !isDesktop) {
      field.renderStatic();
    } else {
      field.render(0);

      ScrollTrigger.create({
        trigger: signature,
        start: "top 85%",
        end: "top 25%",
        scrub: 0.6,
        onUpdate: (self) => field.render(self.progress),
      });

      let resizeRaf = 0;
      window.addEventListener("resize", () => {
        cancelAnimationFrame(resizeRaf);
        resizeRaf = requestAnimationFrame(() => field.resize());
      });
    }
  }
</script>
