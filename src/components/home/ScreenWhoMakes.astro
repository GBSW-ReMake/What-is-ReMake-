---
const members = [
  { handle: "4n5rud", role: "Backend" },
  { handle: "kec08", role: "App" },
  { handle: "songmin102388", role: "Backend" },
  { handle: "hyj090915", role: "Backend" },
  { handle: "ja2x0n", role: "Web" },
  { handle: "wonu1016", role: "Backend" },
  // 새 팀원은 이 배열에 { handle: "...", role: "..." } 를 추가하세요.
];
---

<section class="screen screen--04" id="members" aria-label="Members">
  <div class="wrap">
    <h2 class="who-intro reveal" style="--i:0">MEMBERS</h2>

    <div class="member-marquee-wrap reveal" style="--i:1">
      <div class="member-marquee">
        <ul class="member-grid">
          {members.map((member) => (
            <li class="member">
              <a class="member__link" href={`https://github.com/${member.handle}`} target="_blank" rel="noopener">
                <img class="member__avatar" src={`https://github.com/${member.handle}.png?size=200`} alt="" width="96" height="96" loading="lazy" />
                <span class="member__name">{member.handle}</span>
                <span class="member__role">{member.role}</span>
                <span class="member__github">GitHub →</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="member-grid" aria-hidden="true">
          {members.map((member) => (
            <li class="member">
              <a class="member__link" href={`https://github.com/${member.handle}`} target="_blank" rel="noopener" tabindex="-1">
                <img class="member__avatar" src={`https://github.com/${member.handle}.png?size=200`} alt="" width="96" height="96" loading="lazy" />
                <span class="member__name">{member.handle}</span>
                <span class="member__role">{member.role}</span>
                <span class="member__github">GitHub →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .screen--04 {
    background: var(--color-paper);
    padding-block: var(--space-3xl);
  }
  .who-intro {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display-screen);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2xl);
  }

  .member-marquee-wrap {
    overflow: hidden;
    margin: 0 0 var(--space-3xl);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
  }
  .member-marquee {
    display: flex;
    width: max-content;
    animation: member-scroll 32s linear infinite;
  }
  .member-marquee:hover {
    animation-play-state: paused;
  }
  @keyframes member-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .member-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-2xl);
    padding-inline-end: var(--space-2xl);
  }
  .member {
    flex: 0 0 auto;
    width: 9rem;
  }
  .member__link {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    text-decoration: none;
    color: inherit;
  }
  .member__avatar {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-paper-2);
    outline: var(--rule-hair) solid transparent;
    outline-offset: 3px;
    transition: outline-color var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
  }
  .member__link:hover .member__avatar,
  .member__link:focus-visible .member__avatar {
    outline-color: var(--color-accent-ink);
    transform: scale(1.06);
  }
  .member__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-md);
  }
  .member__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .member__github {
    font-size: var(--text-sm);
    color: var(--color-accent-ink);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);
  }
  .member__link:hover .member__github,
  .member__link:focus-visible .member__github {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .member-marquee { animation: none; }
  }
</style>
