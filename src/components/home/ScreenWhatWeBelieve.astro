---
const stages = ["Build", "Launch", "Operate", "Learn", "ReMake"];
---

<section class="screen screen--03 on-bleed" id="screen-what-we-believe" aria-label="What We Believe">
  <div class="wrap screen__grid">
    <div class="screen__copy">
      <p class="screen__eyebrow reveal" style="--i:0">What we believe</p>
      <h2 class="screen__claim reveal" style="--i:1">We don't build to finish.<br />We build to last.</h2>
      <p class="screen__body reveal" style="--i:2">
        ReMake는 단순히 결과물을 완성하는 것에 머무르지 않습니다. 실제 사용자를 대상으로 서비스를 운영하고,
        사용자의 피드백과 운영 과정에서 발견되는 문제를 바탕으로 서비스를 지속적으로 개선합니다.
      </p>
      <p class="screen__closing" data-closing-line>Build it.<br />Use it.<br />ReMake it.</p>
    </div>

    <div class="cycle-ring" data-cycle>
      <svg class="cycle-ring__svg" viewBox="0 0 240 240" aria-hidden="true">
        <circle class="cycle-ring__track" cx="120" cy="120" r="100" />
        <circle class="cycle-ring__fill" cx="120" cy="120" r="100" data-ring-fill />
      </svg>
      {stages.map((stage, i) => (
        <div class="cycle-node" data-cycle-node style={`--angle: ${i * 72 - 90}deg`}>
          <span class="cycle-node__num">{String(i + 1).padStart(2, "0")}</span>
          <span class="cycle-node__label">{stage}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .screen--03 {
    position: relative;
    min-height: calc(100dvh - 4.5rem);
    display: flex;
    align-items: center;
    background: var(--color-bleed);
    color: var(--color-on-bleed);
    padding-block: var(--space-3xl);
    overflow: clip;
  }
  .screen__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  .screen__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-on-bleed-2);
    margin: 0 0 var(--space-md);
  }
  .screen__claim {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg);
  }
  .screen__body {
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-on-bleed-2);
    max-width: 46ch;
    margin: 0 0 var(--space-xl);
  }
  .screen__closing {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-2xl);
    line-height: 1.2;
    margin: 0;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .screen__closing.is-visible { opacity: 1; }

  .cycle-ring {
    position: relative;
    aspect-ratio: 1;
    max-width: 26rem;
    margin-inline: auto;
    width: 100%;
  }
  .cycle-ring__svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .cycle-ring__track {
    fill: none;
    stroke: var(--color-on-bleed-2);
    stroke-width: 1.5;
    opacity: 0.4;
  }
  .cycle-ring__fill {
    fill: none;
    stroke: var(--color-accent-2);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .cycle-node {
    position: absolute;
    top: 50%;
    left: 50%;
    --radius: 42%;
    transform: rotate(var(--angle)) translate(var(--radius)) rotate(calc(-1 * var(--angle)));
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    text-align: center;
    color: var(--color-on-bleed);
    transition: color 400ms var(--ease-out), transform 400ms var(--ease-out);
  }
  .cycle-node.is-active {
    color: var(--color-accent-2);
    transform: rotate(var(--angle)) translate(var(--radius)) rotate(calc(-1 * var(--angle))) scale(1.1);
  }
  .cycle-node__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-on-bleed-2);
  }
  .cycle-node.is-active .cycle-node__num { color: var(--color-accent-2); }
  .cycle-node__label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-md);
    white-space: nowrap;
  }

  @media (max-width: 60rem) {
    .screen--03 { min-height: auto; padding-block: var(--space-2xl); }
    .screen__grid { grid-template-columns: 1fr; }
    .cycle-ring { order: -1; max-width: 20rem; }
    .cycle-node__label { font-size: var(--text-xs); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { refreshOnSettle } from "../../lib/scroll-refresh";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>(".screen--03");
  const ringFill = section?.querySelector<SVGCircleElement>("[data-ring-fill]");
  const nodes = section?.querySelectorAll<HTMLElement>("[data-cycle-node]");
  const closingLine = section?.querySelector<HTMLElement>("[data-closing-line]");

  if (section && ringFill && nodes) {
    const radius = 100;
    const circumference = 2 * Math.PI * radius;
    ringFill.style.strokeDasharray = String(circumference);

    const applyProgress = (progress: number) => {
      ringFill.style.strokeDashoffset = String(circumference * (1 - progress));
      nodes.forEach((node, i) => {
        const threshold = i / nodes.length;
        node.classList.toggle("is-active", progress >= threshold || progress >= 0.98);
      });
      if (closingLine) {
        const closingOpacity = Math.max(0, Math.min(1, (progress - 0.85) / 0.15));
        closingLine.classList.toggle("is-visible", closingOpacity > 0.05);
      }
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isDesktop = window.matchMedia("(min-width: 60rem)").matches;

    if (reduceMotion || !isDesktop) {
      applyProgress(1);
    } else {
      applyProgress(0);
      ScrollTrigger.create({
        trigger: section,
        start: "top top",
        end: "+=140%",
        scrub: 0.6,
        pin: true,
        onUpdate: (self) => applyProgress(self.progress),
      });
      refreshOnSettle(ScrollTrigger);
    }
  }
</script>
