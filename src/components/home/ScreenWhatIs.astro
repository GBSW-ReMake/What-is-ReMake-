---
---

<section class="screen screen--01" id="screen-what-is" aria-label="What is ReMake?">
  <canvas class="screen__canvas" aria-hidden="true"></canvas>
  <div class="wrap screen__content">
    <h1 class="screen__display reveal" style="--i:0">WE MAKE.<br />WE LEARN.<br />WE REMAKE.</h1>
    <p class="screen__wordmark reveal" style="--i:1">GBSW <span class="brand-mark">ReMake</span></p>
    <p class="screen__lede reveal" style="--i:2">
      학생들이 직접 아이디어를 내고,<br />서비스를 만들고, 실제 사용자에게 제공합니다.
    </p>
    <p class="screen__meaning reveal" style="--i:3">
      <span>IDEA</span><span class="arrow" aria-hidden="true">↓</span>
      <span>MAKE</span><span class="arrow" aria-hidden="true">↓</span>
      <span>RESULT</span><span class="arrow" aria-hidden="true">↓</span>
      <span class="accent">ReMake</span><span class="arrow" aria-hidden="true">↺</span>
    </p>
  </div>
</section>

<style>
  .screen--01 {
    position: relative;
    min-height: calc(100dvh - 4.5rem);
    display: flex;
    align-items: center;
    background: var(--color-paper);
    overflow: clip;
    padding-block: var(--space-3xl);
  }
  .screen__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-ink-2);
    opacity: 0.55;
    pointer-events: none;
  }
  .screen__content {
    position: relative;
    z-index: 1;
  }
  .screen__display {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display-screen);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .screen__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    margin: 0 0 var(--space-md);
  }
  .screen__lede {
    font-size: var(--text-lg);
    max-width: 32ch;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-2xl);
  }
  .screen__meaning {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    color: var(--color-ink-2);
  }
  .screen__meaning .arrow { color: var(--color-rule); }
  .screen__meaning .accent { color: var(--color-accent-ink); font-weight: 500; }

  @media (max-width: 60rem) {
    .screen--01 { min-height: auto; padding-block: var(--space-2xl); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ParticleField, prefersReducedMotion } from "../../lib/particle-text";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>(".screen--01");
  const canvas = section?.querySelector<HTMLCanvasElement>(".screen__canvas");

  if (section && canvas) {
    const isDesktop = window.matchMedia("(min-width: 60rem)").matches;
    const field = new ParticleField(canvas, "REMAKE", {
      color: getComputedStyle(canvas).color,
    });

    if (prefersReducedMotion() || !isDesktop) {
      field.renderStatic();
    } else {
      field.render(0);

      const trigger = ScrollTrigger.create({
        trigger: section,
        start: "top top",
        end: "+=120%",
        scrub: 0.6,
        pin: true,
        onUpdate: (self) => {
          const p = self.progress;
          let formProgress: number;
          let opacity = 0.55;

          if (p < 0.55) {
            formProgress = p / 0.55;
          } else if (p < 0.75) {
            formProgress = 1;
          } else {
            const fade = (p - 0.75) / 0.25;
            formProgress = 1 - fade;
            opacity = 0.55 * (1 - fade);
          }

          field.render(Math.max(0, Math.min(1, formProgress)));
          canvas.style.opacity = String(opacity);
        },
      });

      let resizeRaf = 0;
      window.addEventListener("resize", () => {
        cancelAnimationFrame(resizeRaf);
        resizeRaf = requestAnimationFrame(() => {
          field.resize();
          field.render(trigger.progress);
          ScrollTrigger.refresh();
        });
      });
    }
  }
</script>
