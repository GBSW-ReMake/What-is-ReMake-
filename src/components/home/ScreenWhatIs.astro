---
---

<section class="screen screen--01" id="screen-what-is" aria-label="What is ReMake?">
  <canvas class="screen__canvas" aria-hidden="true"></canvas>
  <p class="screen__remake-text" aria-hidden="true">REMAKE</p>
  <div class="wrap screen__content">
    <h1 class="screen__display reveal" style="--i:0">WE MAKE.<br />WE LEARN.<br />WE REMAKE.</h1>
    <p class="screen__wordmark reveal" style="--i:1">GBSW <span class="brand-mark">ReMake</span></p>
  </div>
</section>

<style>
  .screen--01 {
    position: relative;
    min-height: calc(100dvh - 4.5rem);
    display: flex;
    align-items: center;
    background: var(--color-paper);
    overflow: clip;
    padding-block: var(--space-3xl);
  }
  .screen__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-ink);
    opacity: 0.9;
    pointer-events: none;
  }
  .screen__remake-text {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 22vw, 20rem);
    line-height: 1;
    color: var(--color-ink);
    opacity: 0;
    pointer-events: none;
    margin: 0;
  }
  .screen__content {
    position: relative;
    z-index: 1;
    transition: opacity 200ms var(--ease-out);
  }
  .screen__display {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display-screen);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .screen__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    margin: 0;
  }

  @media (max-width: 60rem) {
    .screen--01 { min-height: auto; padding-block: var(--space-2xl); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ParticleField, prefersReducedMotion } from "../../lib/particle-text";
  import { refreshOnSettle } from "../../lib/scroll-refresh";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>(".screen--01");
  const canvas = section?.querySelector<HTMLCanvasElement>(".screen__canvas");
  const remakeText = section?.querySelector<HTMLElement>(".screen__remake-text");
  const content = section?.querySelector<HTMLElement>(".screen__content");

  if (section && canvas && remakeText && content) {
    const isDesktop = window.matchMedia("(min-width: 60rem)").matches;
    const field = new ParticleField(canvas, "REMAKE", {
      color: getComputedStyle(canvas).color,
      particleCount: 1800,
    });
    remakeText.style.fontSize = `${field.getMatchingFontSize()}px`;

    if (prefersReducedMotion() || !isDesktop) {
      canvas.style.opacity = "0";
      remakeText.style.opacity = "1";
    } else {
      field.render(0);
      canvas.style.opacity = "0.1";

      const MIN_OPACITY = 0.1;
      const BASE_OPACITY = 0.85;

      const trigger = ScrollTrigger.create({
        trigger: section,
        start: "top top",
        end: "+=90%",
        scrub: 0.6,
        pin: true,
        onUpdate: (self) => {
          const p = self.progress;
          let formProgress: number;
          let opacity: number;

          // 0 -> 0.5 scatter into REMAKE (fading in as it forms, so the loose
          // dust never competes with the copy at rest), 0.5 -> 0.7 hold formed
          // at full strength, 0.7 -> 1 gradually dissolve into the real, crisp text
          // (same size as the formed dots, so it reads as a material change, not a cut).
          let textOpacity: number;
          if (p < 0.5) {
            formProgress = p / 0.5;
            opacity = MIN_OPACITY + (BASE_OPACITY - MIN_OPACITY) * formProgress;
            textOpacity = 0;
          } else if (p < 0.7) {
            formProgress = 1;
            opacity = BASE_OPACITY;
            textOpacity = 0;
          } else {
            const resolve = (p - 0.7) / 0.3;
            formProgress = 1;
            opacity = BASE_OPACITY * (1 - resolve);
            textOpacity = resolve;
          }

          field.render(Math.max(0, Math.min(1, formProgress)));
          canvas.style.opacity = String(opacity);
          remakeText.style.opacity = String(textOpacity);

          // Fade the hero copy out entirely once the particle formation holds,
          // so the fully-formed REMAKE is the only thing on screen at the end.
          let contentOpacity: number;
          if (p < 0.15) {
            contentOpacity = 1;
          } else if (p < 0.45) {
            contentOpacity = 1 - (p - 0.15) / 0.3;
          } else {
            contentOpacity = 0;
          }
          content.style.opacity = String(contentOpacity);
        },
      });

      refreshOnSettle(ScrollTrigger);

      let resizeRaf = 0;
      window.addEventListener("resize", () => {
        cancelAnimationFrame(resizeRaf);
        resizeRaf = requestAnimationFrame(() => {
          field.resize();
          field.render(trigger.progress);
          remakeText.style.fontSize = `${field.getMatchingFontSize()}px`;
          ScrollTrigger.refresh();
        });
      });
    }
  }
</script>
