---
---

<section class="screen screen--01" id="screen-what-is" aria-label="What is ReMake?">
  <canvas class="screen__canvas" aria-hidden="true"></canvas>
  <div class="wrap screen__content">
    <h1 class="screen__display reveal" style="--i:0">WE MAKE.<br />WE LEARN.<br />WE REMAKE.</h1>
    <p class="screen__wordmark reveal" style="--i:1">GBSW <span class="brand-mark">ReMake</span></p>
    <p class="screen__lede reveal" style="--i:2">
      학생들이 직접 아이디어를 내고,<br />서비스를 만들고, 실제 사용자에게 제공합니다.
    </p>
    <p class="screen__meaning reveal" style="--i:3">
      <span>IDEA</span><span class="arrow" aria-hidden="true">↓</span>
      <span>MAKE</span><span class="arrow" aria-hidden="true">↓</span>
      <span>RESULT</span><span class="arrow" aria-hidden="true">↓</span>
      <span class="accent">ReMake</span><span class="arrow" aria-hidden="true">↺</span>
    </p>
  </div>
</section>

<style>
  .screen--01 {
    position: relative;
    min-height: calc(100dvh - 4.5rem);
    display: flex;
    align-items: center;
    background: var(--color-paper);
    overflow: clip;
    padding-block: var(--space-3xl);
  }
  .screen__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-ink);
    opacity: 0.9;
    pointer-events: none;
  }
  .screen__content {
    position: relative;
    z-index: 1;
    transition: opacity 200ms var(--ease-out);
  }
  .screen__display {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-display-screen);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .screen__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    margin: 0 0 var(--space-md);
  }
  .screen__lede {
    font-size: var(--text-lg);
    max-width: 32ch;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-2xl);
  }
  .screen__meaning {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    color: var(--color-ink-2);
  }
  .screen__meaning .arrow { color: var(--color-rule); }
  .screen__meaning .accent { color: var(--color-accent-ink); font-weight: 500; }

  @media (max-width: 60rem) {
    .screen--01 { min-height: auto; padding-block: var(--space-2xl); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ParticleField, prefersReducedMotion } from "../../lib/particle-text";
  import { refreshOnSettle } from "../../lib/scroll-refresh";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>(".screen--01");
  const canvas = section?.querySelector<HTMLCanvasElement>(".screen__canvas");
  const content = section?.querySelector<HTMLElement>(".screen__content");

  if (section && canvas && content) {
    const isDesktop = window.matchMedia("(min-width: 60rem)").matches;
    const field = new ParticleField(canvas, "REMAKE", {
      color: getComputedStyle(canvas).color,
      particleCount: 1800,
    });

    if (prefersReducedMotion() || !isDesktop) {
      field.renderStatic();
    } else {
      field.render(0);
      canvas.style.opacity = "0.1";

      const MIN_OPACITY = 0.1;
      const BASE_OPACITY = 0.85;

      const trigger = ScrollTrigger.create({
        trigger: section,
        start: "top top",
        end: "+=120%",
        scrub: 0.6,
        pin: true,
        onUpdate: (self) => {
          const p = self.progress;
          let formProgress: number;
          let opacity: number;

          // 0 -> 0.5 scatter into REMAKE (fading in as it forms, so the loose
          // dust never competes with the copy at rest), 0.5 -> 0.8 hold formed
          // at full strength, 0.8 -> 1 disperse + fade away.
          if (p < 0.5) {
            formProgress = p / 0.5;
            opacity = MIN_OPACITY + (BASE_OPACITY - MIN_OPACITY) * formProgress;
          } else if (p < 0.8) {
            formProgress = 1;
            opacity = BASE_OPACITY;
          } else {
            const fade = (p - 0.8) / 0.2;
            formProgress = 1 - fade;
            opacity = BASE_OPACITY * (1 - fade);
          }

          field.render(Math.max(0, Math.min(1, formProgress)));
          canvas.style.opacity = String(opacity);

          // Fade the hero copy out entirely once the particle formation holds,
          // so the fully-formed REMAKE is the only thing on screen at the end.
          let contentOpacity: number;
          if (p < 0.15) {
            contentOpacity = 1;
          } else if (p < 0.45) {
            contentOpacity = 1 - (p - 0.15) / 0.3;
          } else {
            contentOpacity = 0;
          }
          content.style.opacity = String(contentOpacity);
        },
      });

      refreshOnSettle(ScrollTrigger);

      let resizeRaf = 0;
      window.addEventListener("resize", () => {
        cancelAnimationFrame(resizeRaf);
        resizeRaf = requestAnimationFrame(() => {
          field.resize();
          field.render(trigger.progress);
          ScrollTrigger.refresh();
        });
      });
    }
  }
</script>
